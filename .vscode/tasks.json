{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Ensure Android emulator",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/.vscode/ensure-android-emulator.ps1"
      ],
      "options": {
        "cwd": "${workspaceFolder}/app"
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": false,
        "close": true
      },
      "problemMatcher": []
    }
  ]
}
