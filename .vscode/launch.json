{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Flutter Mobile (Android)",
      "type": "dart",
      "request": "launch",
      "cwd": "${workspaceFolder}/app",
      "program": "${workspaceFolder}/app/lib/main.dart",
      "deviceId": "emulator",
      "preLaunchTask": "Prepare Android run",
      "toolArgs": [
        "--dart-define-from-file=config/local.json"
      ]
    },
    {
      "name": "Flutter Desktop (Windows)",
      "type": "dart",
      "request": "launch",
      "cwd": "${workspaceFolder}/app",
      "program": "${workspaceFolder}/app/lib/main.dart",
      "deviceId": "windows",
      "preLaunchTask": "Sync public Supabase config",
      "toolArgs": [
        "--dart-define-from-file=config/local.json"
      ]
    },
    {
      "name": "React Admin (Web)",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev -- --open",
      "cwd": "${workspaceFolder}/admin",
      "preLaunchTask": "Sync public Supabase config"
    }
  ]
}
